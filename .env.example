# ══════════════════════════════════════════════════════════════════════
# GWAS 流程环境参数模板 —— 复制为 pipeline/.env 后按环境填写
# 位置：pipeline/.env（与代码同目录；singularity/ 镜像目录在 pipeline 同级，不走本文件）
# 优先级：进程环境变量 > .env > pipeline/config.py 内置默认值
# 注意：.env 含密钥（钉钉 access_token），勿提交版本库、勿外传
# 语法：KEY=VALUE；# 整行注释；裸值支持行内 " #" 注释；引号值原样保留
# ══════════════════════════════════════════════════════════════════════

# ── 钉钉机器人通知（不配置 DINGTALK_WEBHOOK 则通知整体静默跳过） ──
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=替换为你的机器人token
DINGTALK_KEYWORD=gwas
DINGTALK_MILESTONES=1

# ── 容器运行时（镜像目录固定为 $WORK/singularity/，目录约定不走本文件） ──
# CONTAINER_RT=singularity

# ── .env 文件本身的位置（默认 $WORK/.env，一般无需修改） ──
# GWAS_ENV_FILE=/abs/path/.env

# ── 目录覆盖（默认基于 $WORK 推导；值为字面路径，不支持变量展开） ──
# GWAS_RAW_DATA=/abs/path/0_raw_data
# GWAS_RESULTS=/abs/path/results
# GWAS_DELIVERY_DIR=/abs/path/Output

# ── 可覆盖阈值（内置默认见 pipeline/config.py；改动同步 DESIGN.md TH 表） ──
# GWAS_DP_MIN=20
# GWAS_DISK_MIN_FREE_GB=200
# GWAS_DISK_PER_SAMPLE_GB=75
